# Slack Bot Configuration
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_BOT_TOKEN_CONTENTS=xoxb-your-contents-bot-token
SLACK_BOT_TOKEN_DATA=xoxb-your-data-bot-token
SLACK_APP_TOKEN=xapp-your-app-token
SLACK_APP_TOKEN_CONTENTS=xapp-your-contents-app-token
SLACK_APP_TOKEN_DATA=xapp-your-data-app-token

# OpenAI Configuration
OPENAI_API_KEY=sk-your-openai-api-key

# Notion Configuration
NOTION_TOKEN=secret_your-notion-integration-token
# 웹훅 구독을 만들 때 노션이 한 번 보내주는 값. 이후 모든 이벤트의 서명 키다
NOTION_WEBHOOK_VERIFICATION_TOKEN=secret_your-notion-webhook-verification-token

# Tavily Search Configuration
TAVILY_API_KEY=tvly-your-tavily-api-key

# AWS Athena Configuration (Phase 1 - Data Analysis Bot)
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=ap-northeast-2
# Note: ATHENA_DATABASE 환경 변수 없음
# AI가 Redash 쿼리를 분석하여 항상 명시적으로 데이터베이스를 지정합니다
ATHENA_OUTPUT_LOCATION=s3://your-bucket/athena-results/

# Redash Configuration (Phase 1 - Data Analysis Bot)
REDASH_API_KEY=your-redash-api-key
REDASH_BASE_URL=https://your-redash-instance.com

# GitHub Configuration
# GITHUB_TOKEN: PR/리뷰 조회 등 읽기 작업용 (repo:read, read:org)
GITHUB_TOKEN=ghp_your-github-personal-access-token

# GITHUB_ADMIN_TOKEN: Organization 관리용 - scripts/github 전용 (repo, admin:org, write:org)
GITHUB_ADMIN_TOKEN=ghp_your-admin-personal-access-token
GITHUB_ORG_NAME=your-organization-name

# Justin Bot Configuration (미팅 보고서/제안서 자동 피드백)
SLACK_BOT_TOKEN_JUSTIN=xoxb-your-justin-bot-token
SLACK_APP_TOKEN_JUSTIN=xapp-your-justin-app-token

# Discord Bot Configuration (연수 사업 수업 종료 공지)
DISCORD_BOT_TOKEN=your-discord-bot-token
DISCORD_GUILD_ID=1504338147155251220
# 간식증빙사진, 출석부사진, 수업사진 순서
DISCORD_TEMPLATE_THREAD_IDS=1504690676661489715,1504690556297809981,1504690489364840488
DISCORD_TEMPLATE_CHANNEL_ID=1504375083546972230
DISCORD_LOG_CHANNEL_ID=1505927819094397038

# 뿌리오 문자 발송 (슬랙 [보내기] 버튼 · scripts/send_sms.py)
# 호출 IP 를 뿌리오에 사전 등록해야 한다. 미등록이면 토큰 발급에서 3003 invalid ip.
PPURIO_ACCOUNT=ppurio-login-id
PPURIO_API_KEY=your-ppurio-api-key
# 계정에 사전등록된 발신번호. 하이픈 없는 숫자만.
PPURIO_SENDER=0212345678

# Google Sheets Configuration
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# 사업 운영 시트용. 이 계정 프로젝트에 Drive API 가 켜져 있어야 한다.
OPERATING_SHEET_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
GOOGLE_SPREADSHEET_ID=1ZP7wyxbwRO2AhyzForm7494C6bMbY_HAeNHV6-WbSnc
GOOGLE_WORKSHEET_ID=451387449

# 나라장터(G2B) 입찰공고정보서비스 인증키 (공공데이터포털 데이터 15129394 활용신청 후 발급, Decoding 키)
# scripts/crawl_education_bids.py 에서 사용
DATA_GO_KR_BID_KEY=

# 지식베이스 Postgres (지식 수집·질의, 채널 작업 리스트 등록 표)
# 채널 멘션 응답 경로가 이 DB 를 읽으므로 값이 없으면 채널에서 봇이 답하지 못한다.
KNOWLEDGE_DATABASE_URL=postgresql://user:password@host:5432/knowledge

# 사내 MCP 서버
# 리소스 URL에는 /mcp 경로를 붙이지 않는다. 두 MCP는 OAuth 메타데이터를 공유한다.
ADMIN_RAILS_BASE_URL=https://admin-rails.codle.io
MCP_RESOURCE_URL=https://wfa.codle.io
