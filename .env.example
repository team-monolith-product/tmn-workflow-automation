# Operate Bot Configuration (운영 업무 에이전트 봇)
SLACK_BOT_TOKEN_OPERATE=xoxb-your-operate-bot-token
SLACK_APP_TOKEN_OPERATE=xapp-your-operate-app-token
# 운영봇 전용 서비스 계정 JSON (필수).
# 위 GOOGLE_SERVICE_ACCOUNT_JSON은 특정 스프레드시트에만 권한이 있는 별도 계정이므로
# 운영봇이 쓸 수 없다. 폴백을 두지 않는다 — 미설정이면 기동 중 즉시 실패한다.
GOOGLE_SERVICE_ACCOUNT_JSON_OPERATE={"type":"service_account","project_id":"..."}
# 봇의 Drive 작업 공간. 브라우저에서 복사한 폴더 링크를 그대로 붙여넣어도 되고
# 폴더 ID만 적어도 된다. 지정되면 검색과 읽기가 이 폴더의 하위 트리로 제한되고,
# 비워두면 제한이 없다. 이 폴더를 운영봇 서비스 계정 이메일에 공유해야 한다(뷰어 권한).
GOOGLE_DRIVE_FOLDER_ID=https://drive.google.com/drive/folders/your-folder-id

